{
  "id": "cc-root", "type": "column", "titlebar": "none", "traffic_lights": [16, 14],
  "theme": "command-center", "preview": "mods/command-center/preview.svg",
  "font": "JetBrains Mono", "font_size": 13, "ui_font": "Chakra Petch",
  "terminal_padding": [10, 12], "terminal_opacity": 1,
  "background": "canvas", "divider": { "width": 1, "color": "border" },
  "children": [
    { "id": "cc-topbar", "type": "block", "size": { "px": 44 }, "min": 44, "max": 44, "window_drag": true,
      "content": { "mod": "command-center", "props": { "role": "topbar" } } },
    { "id": "cc-hud", "type": "column", "size": { "px": 266 }, "min": 150, "max": 760, "resizable": false,
      "divider": { "width": 1, "color": "border" },
      "children": [
        { "id": "cc-deck", "type": "row", "divider": { "width": 1, "color": "border" },
          "children": [
            { "id": "cc-units", "type": "block", "content": { "mod": "command-center", "props": { "role": "units" } } },
            { "id": "cc-sectors", "type": "block", "size": { "px": 340 }, "min": 220, "max": 560,
              "content": { "mod": "command-center", "props": { "role": "sectors" } } } ] },
        { "id": "cc-alert", "type": "block", "size": { "px": 30 },
          "content": { "mod": "command-center", "props": { "role": "alert" } } } ] },
    { "id": "cc-live", "type": "block", "padding": 8, "min": 120,
      "content": { "tab": "active", "pane": {
        "gap": 8, "radius": 0, "background": "background", "lone": true,
        "border": { "width": 1, "color": "border" }, "focus": { "width": 1, "color": "accent" },
        "header": { "content": { "mod": "command-center", "props": { "role": "pane" } },
          "height": 24, "position": "top", "reveal": "always" } } } }
  ]
}
