{
  "id": "ccd-root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    16,
    14
  ],
  "theme": "command-center",
  "preview": "mods/command-center/preview-down.svg",
  "font": "JetBrains Mono",
  "font_size": 13,
  "ui_font": "Chakra Petch",
  "terminal_padding": [
    10,
    12
  ],
  "terminal_opacity": 1,
  "background": "canvas",
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "ccd-topbar",
      "type": "block",
      "size": {
        "px": 44
      },
      "min": 44,
      "max": 44,
      "window_drag": true,
      "content": {
        "mod": "command-center",
        "props": {
          "role": "topbar"
        }
      }
    },
    {
      "id": "ccd-live",
      "type": "block",
      "padding": 8,
      "min": 120,
      "content": {
        "tab": "active",
        "pane": {
          "gap": 8,
          "radius": 0,
          "background": "background",
          "lone": true,
          "border": {
            "width": 1,
            "color": "border"
          },
          "focus": {
            "width": 1,
            "color": "accent"
          },
          "header": {
            "content": {
              "mod": "command-center",
              "props": {
                "role": "pane"
              }
            },
            "height": 24,
            "position": "top",
            "reveal": "always"
          }
        }
      }
    },
    {
      "id": "ccd-hud",
      "type": "column",
      "size": {
        "px": 266
      },
      "min": 150,
      "max": 760,
      "resizable": false,
      "divider": {
        "width": 1,
        "color": "border"
      },
      "children": [
        {
          "id": "ccd-alert",
          "type": "block",
          "size": {
            "px": 30
          },
          "content": {
            "mod": "command-center",
            "props": {
              "role": "alert"
            }
          }
        },
        {
          "id": "ccd-deck",
          "type": "row",
          "divider": {
            "width": 1,
            "color": "border"
          },
          "children": [
            {
              "id": "ccd-units",
              "type": "block",
              "content": {
                "mod": "command-center",
                "props": {
                  "role": "units"
                }
              }
            },
            {
              "id": "ccd-sectors",
              "type": "block",
              "size": {
                "px": 340
              },
              "min": 220,
              "max": 560,
              "content": {
                "mod": "command-center",
                "props": {
                  "role": "sectors"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}